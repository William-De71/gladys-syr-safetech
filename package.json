{
  "name": "gladys-syr-safetech",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for the SYR leak protection devices (SafeTech, SafeTech+, Trio, SafeTech Lock, TRIO Lock, Hansgrohe Pontos Base) over their local JSON API: water shut-off valve, leak alarms, flow, pressure, temperature, water use, profiles, scene triggers and actions, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-syr-safetech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-syr-safetech.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "syr",
    "safetech",
    "leak-protection",
    "water-valve",
    "water-leak",
    "pontos",
    "home-automation"
  ]
}
